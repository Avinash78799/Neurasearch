# ═══════════════════════════════════════════════════════════════════
# NeuraSearch — Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ── Ollama (fully local, offline & air-gapped) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Recommended LLMs: qwen3:8b (balanced/tool-calling), llama3.1:8b, llama3.2:3b (eco/lightweight)
OLLAMA_LLM_MODEL=qwen3:8b
# Recommended Embeddings: qwen3-embedding:0.6b, nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Cloud LLM Providers (Optional for Turbo/Hybrid modes) ──────────
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# ── Auth & Security ───────────────────────────────────────────────
# Optional: Set a persistent JWT secret. If unset, a randomized secret is generated.
# JWT_SECRET=your_long_random_jwt_secret_here

# ── Web Search Fallback (Optional, free tier: 1000 searches/month) ──
# Sign up: https://app.tavily.com
TAVILY_API_KEY=your_key_here

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=neurasearch

# ── BM25 ──────────────────────────────────────────────────────────
BM25_INDEX_PATH=./bm25_index.pkl

# ── App Settings ──────────────────────────────────────────────────
APP_PORT=8000
MAX_HALLUCINATION_RETRIES=2
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Frontend CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

