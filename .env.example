# NeuraSearch Environment Configuration Template
# Copy this file to .env and adjust variables for your environment.

# Local Ollama Configuration (Default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM Providers (Optional for Turbo / Cloud modes)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Authentication & Security
# Optional: Provide a persistent 32+ character secret. If unset, a randomized secret is generated.
# JWT_SECRET=

# External Web Search Fallback (Optional)
# TAVILY_API_KEY=

# Storage & Vector Database Paths
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=neurasearch
BM25_INDEX_PATH=./bm25_index.pkl

# Application Settings
APP_PORT=8000
MAX_HALLUCINATION_RETRIES=2
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Frontend CORS
FRONTEND_URL=http://localhost:5173
