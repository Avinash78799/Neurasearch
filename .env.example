# ═══════════════════════════════════════════════════════════════════
# NeuraSearch — Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ── Ollama (fully local, no API key needed) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.3
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Web Search Fallback (optional, free tier: 1000 searches/month)
# Sign up: https://app.tavily.com
TAVILY_API_KEY=your_key_here

# ── ChromaDB ──────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=neurasearch

# ── BM25 ──────────────────────────────────────────────────────────
BM25_INDEX_PATH=./bm25_index.pkl

# ── App Settings ──────────────────────────────────────────────────
APP_PORT=8000
MAX_HALLUCINATION_RETRIES=2
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Frontend CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
